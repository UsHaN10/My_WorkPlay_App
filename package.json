{
    "name": "workplay-monorepo",
    "version": "1.0.0",
    "description": "Industrial Gamification Platform",
    "private": true,
    "scripts": {
        "install-all": "npm install --prefix client && npm install --prefix server",
        "dev:worker": "npm run dev:worker --prefix client",
        "dev:admin": "npm run dev:admin --prefix client",
        "dev:server": "npm run dev --prefix server",
        "dev": "concurrently \"npm run dev:worker\" \"npm run dev:admin\" \"npm run dev:server\""
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "form-data": "^4.0.6"
    }
}
