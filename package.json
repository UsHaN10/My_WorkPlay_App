{
    "name": "workplay-monorepo",
    "version": "1.0.0",
    "description": "Industrial Gamification Platform",
    "private": true,
    "scripts": {
        "install-all": "npm install --prefix mobile && npm install --prefix server",
        "dev:mobile": "npm start --prefix mobile",
        "dev:server": "npm run dev --prefix server",
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:mobile\""
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "form-data": "^4.0.6"
    }
}